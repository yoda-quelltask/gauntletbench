---
const cleanQuant = (q, f) => { if (!q) return q; let s = String(q); const fl = String(f||''); if (fl) { const re = new RegExp('\\b' + fl + '\\b', 'ig'); s = s.replace(re, '').replace(/\s{2,}/g, ' ').trim(); } return s; };

import Base from '../../layouts/Base.astro';
import Radar from '../../components/Radar.astro';
import Progress from '../../components/Progress.astro';
import { data, rankedModels, AXIS_ORDER, axisMeta, fmtAxis, fmt1, SMALL_TIP } from '../../lib/data.js';

export function getStaticPaths() {
  return rankedModels.map((model, i) => ({
    params: { slug: model.slug },
    props: { model, rank: i + 1 },
  }));
}

const { model, rank } = Astro.props;

const barBand = (score) => (score >= 16 ? 'hi' : score >= 8 ? 'mid' : 'low');

// Per-suite rows in canonical suite order
const suiteRows = data.suites
  .filter((s) => model.suites[s.id])
  .map((s) => {
    const r = model.suites[s.id];
    const perTest = r.per_test ?? [];
    // category rollup: mean score per category, in first-seen order
    const catOrder = [];
    const catAcc = {};
    for (const t of perTest) {
      if (!catAcc[t.category]) { catAcc[t.category] = { sum: 0, n: 0 }; catOrder.push(t.category); }
      catAcc[t.category].sum += t.score;
      catAcc[t.category].n += 1;
    }
    const rollup = catOrder.map((c) => ({ category: c, mean: catAcc[c].sum / catAcc[c].n }));
    return {
      id: s.id,
      name: s.name,
      scoreTotal: r.score_total,
      maxTotal: r.tests_total * s.max_score_per_test,
      scoreAvg: r.score_avg,
      testsRun: r.tests_run,
      testsTotal: r.tests_total,
      tokS: r.avg_tok_s,
      runDate: r.run_date ?? null,
      perTest,
      rollup: rollup.length > 1 ? rollup : [],
    };
  });

const statusLabels = {
  'daily-driver': 'Daily driver',
  'daily-driver-trial': 'Daily-driver trial',
  keeper: 'Keeper',
  candidate: 'Candidate',
  tested: 'Tested',
  retired: 'Retired',
};
const statusLabel = statusLabels[model.status] ?? model.status;
---
<Base
  title={model.name}
  description={`${model.name} on the GAUNTLET Bench leaderboard — ${model.axes_scored}/8 axes scored. Models run the gauntlet.`}
>
  <div class="model-head">
    <a class="back" href="/">← Leaderboard</a>
    <h1>{model.name}{model.cls === 'small' && <span class="chip chip-small" title={SMALL_TIP}>SMALL</span>}</h1>
    <div class="sub">
      <span class={`status ${model.status}`}>{statusLabel}</span>
      {model.axes_scored === 8 && <span class="ran-badge" title="Scored on all eight axes">RAN THE GAUNTLET</span>}
      <span>Rank #{rank} of {rankedModels.length}</span>
      <span>·</span>
      <Progress model={model} label={true} />
      <span style="font-size:12px;color:var(--muted)">GAUNTLET progress</span>
    </div>
  </div>

  <div class="model-grid">
    <div class="panel radar-panel">
      <Radar axes={model.axes} size={320} legend={true} />
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:6px 14px;margin-top:16px;width:100%;max-width:320px;">
        {AXIS_ORDER.map((key) => (
          <div style="text-align:center;">
            <div style="font-family:var(--display);font-size:11px;font-weight:600;color:var(--muted);letter-spacing:.08em;" title={axisMeta[key].name}>{axisMeta[key].letter}</div>
            {model.axes[key] != null
              ? <div class="num" style="font-size:13.5px;font-weight:600;color:var(--text-dim);">{fmtAxis(model.axes[key])}</div>
              : key === 't'
                ? <div style="font-size:11px;color:var(--muted);font-style:italic;" title="fewer than 15 observed tests">n/d</div>
                : <div class="na" style="font-size:13.5px;">—</div>}
          </div>
        ))}
      </div>
    </div>

    <div style="display:flex;flex-direction:column;gap:20px;">
      <div class="panel">
        <h2>Specification</h2>
        <dl class="spec-grid">
          <dt>Parameters</dt><dd>{model.params}</dd>
          <dt>Architecture</dt><dd>{model.arch}</dd>
          <dt>Size on disk</dt><dd>{model.size_gb} GB</dd>
          <dt>Quantization</dt><dd>{cleanQuant(model.quant, model.format)}</dd>
          <dt>Format</dt><dd>{model.format}</dd>
          <dt>Class</dt><dd>{model.cls === 'small' ? 'Small (under 8B total parameters — phone/edge class)' : 'Standard'}</dd>
          <dt>Reasoning (CoT)</dt><dd>{model.is_cot ? 'Yes — emits reasoning tokens' : 'No'}</dd>
          {model.base_org && (<><dt>Base org</dt><dd>{model.base_org}</dd></>)}
          <dt>Internal ID</dt><dd>{model.internal_id}</dd>
          {model.mean_tok_s != null && (<><dt>Mean speed</dt><dd>{fmt1(model.mean_tok_s)} tok/s across suites</dd></>)}
          {model.thinking && (<><dt>Stall census</dt><dd>{model.thinking.stalls} stall{model.thinking.stalls === 1 ? '' : 's'} in {model.thinking.tests_seen} observed tests ({(model.thinking.stall_rate * 100).toFixed(1)}%)</dd></>)}
          {model.thinking && model.thinking.mean_reasoning_tokens > 0 && (<><dt>Reasoning appetite</dt><dd>{Math.round(model.thinking.mean_reasoning_tokens).toLocaleString()} tokens mean · {model.thinking.max_reasoning_tokens.toLocaleString()} max</dd></>)}
          {model.model_card_url && (
            <><dt>Model card</dt><dd><a href={model.model_card_url} rel="noopener">{new URL(model.model_card_url).hostname}</a></dd></>
          )}
        </dl>
      </div>

      <div class="panel">
        <h2>Suite results</h2>
        {suiteRows.length > 0 ? (
          <div class="suite-acc-wrap">
            <div class="suite-acc">
              <div class="acc-head">
                <span></span>
                <span>Suite</span>
                <span>Score</span>
                <span>Avg / 20</span>
                <span>Tests</span>
                <span>tok/s</span>
                <span>Run</span>
              </div>
              {suiteRows.map((row) =>
                row.perTest.length > 0 ? (
                  <details>
                    <summary class="acc-row" title="Per-test breakdown">
                      <span class="caret" aria-hidden="true">▶</span>
                      <span class="suite-name">{row.name} <span class="chip" style="margin-left:4px;">{row.id}</span></span>
                      <span class="cell-num">{fmt1(row.scoreTotal)} / {row.maxTotal}</span>
                      <span class="cell-num">{fmt1(row.scoreAvg)}</span>
                      <span class="cell-num">{row.testsRun}/{row.testsTotal}</span>
                      <span class="cell-num">{row.tokS != null ? fmt1(row.tokS) : '—'}</span>
                      <span class="run-date">{row.runDate ? `run ${row.runDate}` : '—'}</span>
                    </summary>
                    <div class="ptest-panel">
                      <table class="ptest">
                        <thead>
                          <tr>
                            <th>Test</th>
                            <th>Category</th>
                            <th>Score</th>
                            <th aria-hidden="true"></th>
                            <th>tok/s</th>
                          </tr>
                        </thead>
                        <tbody>
                          {row.perTest.map((t) => (
                            <tr>
                              <td class="tid">{t.id}</td>
                              <td class="cat">{t.category}</td>
                              <td class="score num">{fmt1(t.score)}/20</td>
                              <td>
                                <span class="tbar" role="img" aria-label={`${fmt1(t.score)} of 20`}>
                                  <span class={`fill ${barBand(t.score)}`} style={`width:${Math.max(2, (t.score / 20) * 100)}%`}></span>
                                </span>
                              </td>
                              <td class="toks num">{t.tok_s != null ? fmt1(t.tok_s) : '—'}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                      {row.rollup.length > 0 && (
                        <p class="cat-rollup">
                          <span style="text-transform:uppercase;letter-spacing:.08em;font-family:var(--display);font-size:10.5px;color:#64748b;">Category mean</span>
                          {row.rollup.map((c) => (
                            <span class="cr">{c.category} <b>{fmt1(c.mean)}</b></span>
                          ))}
                        </p>
                      )}
                    </div>
                  </details>
                ) : (
                  <div class="acc-row">
                    <span class="caret-spacer"></span>
                    <span class="suite-name">{row.name} <span class="chip" style="margin-left:4px;">{row.id}</span></span>
                    <span class="cell-num">{fmt1(row.scoreTotal)} / {row.maxTotal}</span>
                    <span class="cell-num">{fmt1(row.scoreAvg)}</span>
                    <span class="cell-num">{row.testsRun}/{row.testsTotal}</span>
                    <span class="cell-num">{row.tokS != null ? fmt1(row.tokS) : '—'}</span>
                    <span class="run-date">{row.runDate ? `run ${row.runDate}` : '—'}</span>
                  </div>
                )
              )}
            </div>
          </div>
        ) : (
          <p style="color:var(--muted);font-size:13.5px;margin:0;">No suite results recorded yet.</p>
        )}
        <p style="font-size:12px;color:var(--muted);margin:12px 0 0;">
          Each test is LLM-judged 0–20 against a fixed rubric; suite max = tests × 20.
          Rows with a <span class="caret" style="font-size:9px;">▶</span> expand to the per-test breakdown.
          Where fewer tests ran than the suite total, unrun tests count as zero toward the axis score.
          See <a href="/gauntlet">methodology</a>.
        </p>
      </div>
    </div>
  </div>
</Base>
