---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => import.meta.env.DEV || !data.draft);
  return articles.map((entry) => ({
    params: { slug: entry.data.slug ?? entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={entry.data.title} description={entry.data.summary}>
  <article class="article">
    <div class="article-head">
      <a class="back" href="/articles/" style="font-size:13px;color:var(--muted);">← All articles</a>
      <h1>{entry.data.title}</h1>
      <div class="article-meta" style="margin-top:10px;">
        <span>{fmtDate(entry.data.date)}</span>
      </div>
      {entry.data.tags.length > 0 && (
        <div class="designation">
          {entry.data.tags.map((t) => <span class="chip">{t}</span>)}
        </div>
      )}
    </div>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
