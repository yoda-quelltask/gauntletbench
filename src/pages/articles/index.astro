---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

// Drafts are outlines awaiting review. They live in the repo so they can be
// diffed, and stay off the site until they are prose — import.meta.env.DEV lets
// you see them locally without publishing them.
const articles = (await getCollection('articles', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base
  title="Articles"
  description="Longer-form writing from the GAUNTLET bench: what actually moves local-model performance, and what only looks like it does."
>
  <div class="page-head">
    <p class="kicker">Writing</p>
    <h1>Articles</h1>
    <p class="lede">
      Rounds report what a batch of tests found. Education explains the vocabulary.
      Articles are the longer arguments that cut across both — the things this bench
      learned the hard way and would rather you did not have to.
    </p>
  </div>

  {articles.length > 0 ? (
    <div class="card-grid">
      {articles.map((article) => (
        <a class="round-card" href={`/articles/${article.data.slug ?? article.id}/`}>
          <span class="date">{fmtDate(article.data.date)}</span>
          <h2>{article.data.title}{article.data.draft && <span class="chip"> draft</span>}</h2>
          <p>{article.data.summary}</p>
          {article.data.tags.length > 0 && (
            <span class="designation">
              {article.data.tags.map((t) => <span class="chip">{t}</span>)}
            </span>
          )}
        </a>
      ))}
    </div>
  ) : (
    <div class="stub">
      <h2>Nothing published yet</h2>
      <p>The first article is in outline. It will appear here once it is written.</p>
    </div>
  )}
</Base>
