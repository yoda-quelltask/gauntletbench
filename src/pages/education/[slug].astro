---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('education');
  return articles.map((entry) => ({
    params: { slug: entry.data.slug ?? entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const clusterNames: Record<string, string> = {
  concepts: 'How Local AI Works',
  methodology: 'How GAUNTLET Scores Models',
};

const all = (await getCollection('education')).sort(
  (a, b) => a.data.order - b.data.order
);
const idx = all.findIndex((e) => e.id === entry.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : null;
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={entry.data.title} description={entry.data.summary}>
  <article class="article">
    <div class="article-head">
      <a class="back" href="/education/" style="font-size:13px;color:var(--muted);">← All guides</a>
      <h1>{entry.data.title}</h1>
      <div class="article-meta">
        <span class="chip">{clusterNames[entry.data.cluster]}</span>
        <span>Part {entry.data.order} of {all.length}</span>
        <span>Updated {fmtDate(entry.data.updated)}</span>
      </div>
    </div>
    <div class="prose">
      <Content />
    </div>
    <div class="article-meta" style="margin-top:32px;display:flex;justify-content:space-between;gap:16px;">
      {prev ? (
        <a href={`/education/${prev.data.slug ?? prev.id}/`} style="font-size:13px;">← {prev.data.title}</a>
      ) : <span />}
      {next ? (
        <a href={`/education/${next.data.slug ?? next.id}/`} style="font-size:13px;text-align:right;">{next.data.title} →</a>
      ) : <span />}
    </div>
  </article>
</Base>
