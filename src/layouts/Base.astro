---
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '../styles/global.css';
import { data, generatedAt, GITHUB_URL } from '../lib/data.js';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Models run the gauntlet.' } = Astro.props;
const fullTitle = title === 'GAUNTLET Bench' ? title : `${title} · GAUNTLET Bench`;

const navItems = [
  { label: 'Leaderboard', href: '/' },
  { label: 'Methodology', href: '/gauntlet' },
  { label: 'Rounds', href: '/rounds' },
  { label: 'Arena', href: '/arena' },
  { label: 'Contribute', href: '/contribute' },
  { label: 'About', href: '/about' },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/models') : path.startsWith(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GAUNTLET Bench" />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <header class="site-nav">
      <div class="nav-inner">
        <a class="wordmark" href="/">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="M16 2l11 4.2v8.6c0 7.1-4.6 12.3-11 15.2C9.6 27.1 5 21.9 5 14.8V6.2L16 2z" fill="none" stroke="#2563EB" stroke-width="2.2" stroke-linejoin="round"/>
            <circle cx="16" cy="9.5" r="1.8" fill="#22C55E"/>
            <circle cx="21.5" cy="13.5" r="1.6" fill="#2563EB"/>
            <circle cx="19.4" cy="19.8" r="1.6" fill="#2563EB"/>
            <circle cx="12.6" cy="19.8" r="1.6" fill="#2563EB"/>
            <circle cx="10.5" cy="13.5" r="1.6" fill="#2563EB"/>
          </svg>
          GAUNTLET&nbsp;<span class="bench">Bench</span>
        </a>
        <nav class="nav-links" aria-label="Main">
          {navItems.map((item) => (
            <a href={item.href} class={isActive(item.href) ? 'active' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <span>Built from the GAUNTLET data pipeline · data generated {generatedAt}</span>
        <span>
          All scores measured on {data.host.hw}, {data.host.runner} ·
          <a href={GITHUB_URL} rel="noopener">GitHub</a>
        </span>
      </div>
    </footer>
  </body>
</html>
