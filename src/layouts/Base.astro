---
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '../styles/global.css';
import { data, generatedAt, GITHUB_URL } from '../lib/data.js';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Models run the gauntlet.' } = Astro.props;
const fullTitle = title === 'GAUNTLET Bench' ? title : `${title} · GAUNTLET Bench`;

const navItems = [
  { label: 'Leaderboard', href: '/' },
  { label: 'Rounds', href: '/rounds' },
  { label: 'Arena', href: '/arena' },
  { label: 'Articles', href: '/articles' },
  { label: 'Education', href: '/education' },
  { label: 'Lab', href: '/lab' },
  { label: 'Methodology', href: '/gauntlet' },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/models') : path.startsWith(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GAUNTLET Bench" />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta property="og:image" content="https://gauntletbench.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://gauntletbench.com/og.png" />
    <link rel="alternate" type="application/rss+xml" title="GAUNTLET Bench — Rounds" href="/rss.xml" />
  </head>
  <body>
    <header class="site-nav">
      <div class="nav-inner">
        <a class="wordmark" href="/">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="M16 2l11 4.2v8.6c0 7.1-4.6 12.3-11 15.2C9.6 27.1 5 21.9 5 14.8V6.2L16 2z" fill="none" stroke="#2563EB" stroke-width="2.2" stroke-linejoin="round"/>
            <circle cx="16" cy="9.5" r="1.8" fill="#22C55E"/>
            <circle cx="21.5" cy="13.5" r="1.6" fill="#2563EB"/>
            <circle cx="19.4" cy="19.8" r="1.6" fill="#2563EB"/>
            <circle cx="12.6" cy="19.8" r="1.6" fill="#2563EB"/>
            <circle cx="10.5" cy="13.5" r="1.6" fill="#2563EB"/>
          </svg>
          GAUNTLET&nbsp;<span class="bench">Bench</span>
        </a>
        <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle navigation menu" />
        <label for="nav-toggle" class="nav-burger" aria-hidden="true">
          <span></span><span></span><span></span>
        </label>
        <nav class="nav-links" aria-label="Main">
          {navItems.map((item) => (
            <a href={item.href} class={isActive(item.href) ? 'active' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <span class="footer-mark">
            <svg viewBox="0 0 32 32" aria-hidden="true">
              <path d="M16 2l11 4.2v8.6c0 7.1-4.6 12.3-11 15.2C9.6 27.1 5 21.9 5 14.8V6.2L16 2z" fill="none" stroke="#2563EB" stroke-width="2.2" stroke-linejoin="round"/>
              <circle cx="16" cy="9.5" r="1.8" fill="#22C55E"/>
            </svg>
            GAUNTLET Bench
          </span>
          <p>
            Models run the gauntlet. Local-LLM proving ground: agentic, live, verified —
            every score measured on {data.host.hw}, {data.host.runner}.
          </p>
        </div>
        <div class="footer-col">
          <h3>Sections</h3>
          <ul>
            <li><a href="/">Leaderboard</a></li>
            <li><a href="/rounds/">Rounds</a></li>
            <li><a href="/arena/">Arena</a></li>
            <li><a href="/articles/">Articles</a></li>
            <li><a href="/education/">Education</a></li>
            <li><a href="/lab/">Lab</a></li>
            <li><a href="/gauntlet/">Methodology</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h3>Meta</h3>
          <ul>
            <li><a href="/about/">About</a></li>
            <li><a href="/contribute/">Contribute</a></li>
            <li><a href={GITHUB_URL} rel="noopener">GitHub</a></li>
            <li><a href="/rss.xml">RSS</a></li>
            <li><span class="gen">data generated {generatedAt}</span></li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
